# Copy to .env and fill in. This file is read only by the backend container; nothing here reaches the browser.

# Anthropic API key (https://console.anthropic.com). Without it the app still works with the offline starter builder.
ANTHROPIC_API_KEY=

# Only if your key is NOT scoped to a workspace: the workspace ID (wrkspc_...) from console.anthropic.com -> Settings -> Workspaces
ANTHROPIC_WORKSPACE_ID=

# 4-digit parent PIN used until you change it in Parent mode -> Settings.
PARENT_PIN=1234

# Optional: Sarvam AI key for Telugu speech (https://www.sarvam.ai). Leave empty to use the browser voice.
SARVAM_API_KEY=

# Models (defaults shown)
MODEL_QUICK=claude-haiku-5-5
MODEL_INVENTORY=claude-sonnet-5-5
MODEL_BIG=claude-opus-5-5

# For the INR column on the cost meter
USD_TO_INR=84
